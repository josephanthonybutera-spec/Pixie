# Supabase — required for auth + persistence. Without these the app runs in
# the original no-account demo mode.
# Project settings → API. The anon key is safe for the browser; Row Level
# Security restricts every table to the signed-in user's own rows.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
